# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Environment & secret files (NEVER commit or push)
.env
*.env
.env.*

# Markdown documentation files (NEVER push .md files except README.md)
*.md
!README.md

# Extracted game workspaces, builds & backups
*_extracted/
recompiled_build/
backups/
*.bak

# Downloaded portable external tools (auto-fetched on demand)
tools/
